{
  "_note": "Starting hypothesis, not brand law. Change values here only; templates must read every visual constant from this file.",
  "canvas": { "width": 1080, "height": 1920, "fps": 30 },
  "safe_zone": { "top": 220, "bottom": 480, "left": 60, "right": 140 },
  "colors": {
    "bg": "#0B0B0C",
    "bg_alt": "#15161A",
    "text": "#F2EFE9",
    "muted": "#D6D2CA",
    "accent": "#E8A54B",
    "caption_highlight": "#E8A54B",
    "card_bg": "rgba(11,11,12,0.72)"
  },
  "fonts": {
    "display": { "family": "Anton", "file": "brand/fonts/Anton-Regular.ttf", "license": "OFL" },
    "body": { "family": "Inter", "file": "brand/fonts/Inter-SemiBold.ttf", "weight": 600, "license": "OFL" }
  },
  "type_scale": {
    "hook_slam": 96,
    "typography_statement": 84,
    "typography_number": 220,
    "card": 64,
    "kicker": 40,
    "caption": 58,
    "label": 40,
    "cta": 44
  },
  "line_height": { "display": 1.05, "body": 1.25 },
  "padding": { "card": [28, 36], "pill": [16, 32] },
  "radius": { "card": 24, "pill": 999 },
  "caption": { "max_lines": 2, "max_chars_per_line": 28, "center_y": 1180 },
  "motion": {
    "still_zoom": [1.0, 1.08],
    "still_pan_px": 80,
    "cut": "hard",
    "overlay_in_ms": 120,
    "cta_in_ms": 180
  },
  "motion_presets": {
    "_note": "Opt-in per spec (motion_preset) or beat (motion). Absent = the plain still_zoom/still_pan_px behavior above. push = eased push-in as a fraction of the starting scale; drift offsets are px of slow sway (the start scale is raised so drift never shows an edge); punch_in = hard cut to a tighter crop on beats longer than min_beat_sec; glow_pulse = brightness +/- amount; particles = seeded embers (opacity is the max; caption_opacity is the fraction of it left behind captions/label/overlay); number_card = slam-in, soft pulse, previous still dimmed (brightness) behind it.",
    "calm": {
      "push": 0.06,
      "ease": "sine.inOut",
      "drift": { "x_px": 14, "y_px": 10, "period_sec": 9 },
      "punch_in": null,
      "glow_pulse": null,
      "particles": null,
      "number_card": { "slam_from": 1.15, "slam_sec": 0.4, "pulse": 0.02, "pulse_sec": 1.6, "dim_prev": 0.35 }
    },
    "drift": {
      "push": 0.12,
      "ease": "sine.inOut",
      "drift": { "x_px": 28, "y_px": 20, "period_sec": 7 },
      "punch_in": null,
      "glow_pulse": { "amount": 0.05, "period_sec": 3 },
      "particles": { "count": 10, "opacity": 0.4, "size_px": [6, 14], "speed_px_s": [20, 50], "caption_opacity": 0.2 },
      "number_card": { "slam_from": 1.4, "slam_sec": 0.32, "pulse": 0.03, "pulse_sec": 1.4, "dim_prev": 0.3 }
    },
    "punch": {
      "push": 0.16,
      "ease": "power1.inOut",
      "drift": { "x_px": 40, "y_px": 28, "period_sec": 6 },
      "punch_in": { "min_beat_sec": 3.5, "scale": 1.35 },
      "glow_pulse": { "amount": 0.08, "period_sec": 2.5 },
      "particles": { "count": 18, "opacity": 0.55, "size_px": [6, 16], "speed_px_s": [30, 80], "caption_opacity": 0.2 },
      "number_card": { "slam_from": 1.7, "slam_sec": 0.3, "pulse": 0.04, "pulse_sec": 1.2, "dim_prev": 0.3 }
    }
  },
  "grade": {
    "vignette": 0.35,
    "darken_behind_text": 0.45,
    "darken_behind_text_max": 0.8,
    "darken_bright_luma": 0.75,
    "darken_feather_px": 120
  },
  "audio": {
    "target_lufs": -14,
    "true_peak_db": -1,
    "tail_sec": 0.6,
    "music_duck_db": -8,
    "music_duck_attack_sec": 0.15,
    "music_duck_release_sec": 0.6
  }
}
